RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]
Header always set Content-Security-Policy "upgrade-insecure-requests"

# Define custom error pages
ErrorDocument 301 /404Notfound.html 
ErrorDocument 404 /404Notfound.html 

# Rewrite rules for clean URLs
RewriteRule ^Home$ index.html [L]
RewriteRule ^contact.html$ contact.html [L]
RewriteRule ^About-Us$ about.html [L]   
RewriteRule ^Comilia$ Comilia.html [L]   
RewriteRule ^Delia$ Delia.html [L]   
RewriteRule ^Duca$ Duca.html [L]   
RewriteRule ^Nero$ Nero.html [L]   
RewriteRule ^Robern$ Robern.html [L]   
RewriteRule ^Vera$ vera.html [L]   
RewriteRule ^Volga$ Volga.html [L]   
RewriteRule ^Willow$ Willow.html [L]   
RewriteRule ^Basin-Collection$ HDHMR-Collection.html [L]   
RewriteRule ^PVC-Vanity-Collections$ PVC-vanity-collections.html [L]   
RewriteRule ^Slab-Vanity-Collection$ Slab-Vanity-Collection.html [L]   
RewriteRule ^Catalogue$ Catalogue.html [L]   

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Set caching for static resources (optional, if needed)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>